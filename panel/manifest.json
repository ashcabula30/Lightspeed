{
  "manifestVersion": 5,
  "id": "com.goodo.editing-assistant",
  "name": "Editing Assistant",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editingAssistantPanel",
      "label": { "default": "Editing Assistant" },
      "minimumSize": { "width": 300, "height": 260 },
      "preferredDockedSize": { "width": 360, "height": 560 },
      "preferredFloatingSize": { "width": 400, "height": 620 }
    },
    {
      "type": "panel",
      "id": "editingAssistantChat",
      "label": { "default": "Editing Assistant Chat" },
      "minimumSize": { "width": 300, "height": 300 },
      "preferredDockedSize": { "width": 380, "height": 600 },
      "preferredFloatingSize": { "width": 440, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "launchProcess": { "schemes": [], "extensions": [".cmd"] }
  }
}
