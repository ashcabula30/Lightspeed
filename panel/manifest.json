{
  "manifestVersion": 5,
  "id": "com.goodo.editing-assistant",
  "name": "Editing Assistant",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editingAssistantPanel",
      "label": { "default": "Editing Assistant" },
      "minimumSize": { "width": 300, "height": 260 },
      "preferredDockedSize": { "width": 360, "height": 560 },
      "preferredFloatingSize": { "width": 400, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://127.0.0.1:7790"] }
  }
}
